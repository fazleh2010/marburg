                            <figure class="bundle phone">
                                <a href="http://localhost:8000/collection/politics-of-photography/">
                                    <div class="image-frame">

                                        <img class="landscape" srcset="http://localhost:8000/RomArchive_files/19ea164a49057c8339842d44347b0fc4.jpg 1x, http://localhost:8000/RomArchive_files/c45af89cfc3daf3507e7af1ac43eb6fa.jpg 2x" src="http://localhost:8000/RomArchive_files/19ea164a49057c8339842d44347b0fc4.jpg">

